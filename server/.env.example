# Optional backend-only fallback template; shared root .env* values take precedence.
# Set secrets in the backend host's secret manager; never commit populated env files.
NODE_ENV=production
PORT=5000
TRUST_PROXY=1
REQUEST_BODY_LIMIT=200mb

# Include the database name and credentials in the URI. Keep this backend-only.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/goldflow?retryWrites=true&w=majority
MONGODB_DB_NAME=goldflow

# Generate a unique secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Used only by server/scripts/create_admin_v2.js; leave unset otherwise.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Comma-separated exact frontend origins. Do not use * with credentialed requests.
CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=true

# Optional. Redis is bypassed when REDIS_URL is unset or unavailable.
REDIS_URL=
REDIS_CACHE_ENABLED=false
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=120
CACHE_VERSION_TTL=86400
CACHE_PREFIX=goldflow

# Cookie behavior supported by server/utils/authCookie.js.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_DOMAIN=
# Optional; production defaults to __Host-goldflow_session.
# AUTH_COOKIE_NAME=__Host-goldflow_session

# Backup settings. Zero intervals disable the built-in backup scheduler.
BACKUP_STORAGE_PATH=./backups
BACKUP_RETENTION_DAYS=8
BACKUP_KEEP_LATEST_COUNT=10
BACKUP_MAX_COUNT=25
BACKUP_INTERVAL_HOURS=0
BACKUP_INTERVAL_MINUTES=0
# Optional absolute paths when MongoDB Database Tools are not on PATH.
# MONGODUMP_PATH=/usr/bin/mongodump
# MONGORESTORE_PATH=/usr/bin/mongorestore