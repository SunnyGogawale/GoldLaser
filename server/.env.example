# Use a secret-managed MongoDB URI in staging/production; this local URI is only a development example.
MONGODB_URI=mongodb://localhost:27017/goldflow
MONGODB_APP_NAME=goldflow

# Pool limits apply per application process and per MongoDB server. Writes always use the primary.
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_RECONNECT_BASE_DELAY_MS=1000
MONGODB_READ_PREFERENCE=primary

# Monitoring metadata is sampled and expires automatically; no query parameters or credentials are stored.
DB_MONITORING_ENABLED=true
DB_MONITORING_REFRESH_INTERVAL_MS=15000
DB_MONITORING_SNAPSHOT_INTERVAL_MS=60000
DB_MONITORING_ACTIVE_WINDOW_MS=180000
DB_ACTIVITY_MAX_EVENTS_PER_MINUTE=20
DB_ACTIVITY_RETENTION_DAYS=30

# Optional; must be unique for each concurrent app process if explicitly set.
APP_INSTANCE_ID=