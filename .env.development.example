# Copy to the workspace root as .env.development for local development.
NODE_ENV=development
VITE_API_URL=http://localhost:5001
VITE_APP_NAME=GoldFlow
VITE_APP_ENV=development
VITE_BACKUP_REFRESH_MS=15000
DEV_HOST=127.0.0.1
DEV_PORT=5173
DEV_STRICT_PORT=true

PORT=5001
MONGODB_URI=mongodb://localhost:27017/goldflow
MONGODB_DB_NAME=goldflow
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
REDIS_URL=
REDIS_CACHE_ENABLED=false
CACHE_ENABLED=true
TRUST_PROXY=1
REQUEST_BODY_LIMIT=200mb
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_NAME=
BCRYPT_SALT_ROUNDS=10
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
CACHE_DEFAULT_TTL=120
CACHE_VERSION_TTL=86400
CACHE_PREFIX=goldflow
BACKUP_STORAGE_PATH=./backups
BACKUP_RETENTION_DAYS=8
BACKUP_KEEP_LATEST_COUNT=10
BACKUP_MAX_COUNT=25
BACKUP_INTERVAL_HOURS=0
BACKUP_INTERVAL_MINUTES=0
MONGODUMP_PATH=
MONGORESTORE_PATH=