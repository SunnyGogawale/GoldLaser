# Production profile template only; never commit a populated .env.production.
# Set VITE_* values in frontend build settings. They are public in browser assets.
NODE_ENV=production
VITE_API_URL=https://api.example.com
VITE_APP_NAME=GoldFlow
VITE_APP_ENV=production
VITE_BACKUP_REFRESH_MS=15000

# Backend values are read at runtime. Put actual secrets in the server secret manager.
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/goldflow?retryWrites=true&w=majority
MONGODB_DB_NAME=goldflow
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=true
REDIS_URL=
REDIS_CACHE_ENABLED=false
CACHE_ENABLED=true
TRUST_PROXY=1
REQUEST_BODY_LIMIT=200mb
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_NAME=
BCRYPT_SALT_ROUNDS=12
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
CACHE_DEFAULT_TTL=120
CACHE_VERSION_TTL=86400
CACHE_PREFIX=goldflow
BACKUP_STORAGE_PATH=./backups
BACKUP_RETENTION_DAYS=8
BACKUP_KEEP_LATEST_COUNT=10
BACKUP_MAX_COUNT=25
BACKUP_INTERVAL_HOURS=0
BACKUP_INTERVAL_MINUTES=0
MONGODUMP_PATH=
MONGORESTORE_PATH=